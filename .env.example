NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed so admin can list every account, and so Stripe webhooks can write ads.
SUPABASE_SERVICE_ROLE_KEY=

# Sign up with this exact email to become the operator (not hardcoded in the UI).
ADMIN_EMAIL=

# Prefer a restricted key with Checkout, Products, Prices, Customers, Invoices, Billing Portal.
STRIPE_SECRET_KEY=
# Optional alias if you store the restricted key separately (either this or STRIPE_SECRET_KEY).
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave off until you are ready to take real checkout and plan charges.
# PAYMENTS_ENABLED=true
# NEXT_PUBLIC_PAYMENTS_ENABLED=true

# Optional. Admin → Payments can create these products and save the IDs instead.
STRIPE_PRICE_EARLY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PREMIUM=

# Optional. Real courier scans (EasyPost or Aftership). Without these, money stays
# held until the shopper confirms they received the piece. Test Stripe keys also
# accept EasyPost demo numbers such as EZ2000000002.
# EASYPOST_API_KEY=
# AFTERSHIP_API_KEY=
# CRON_SECRET=
# EasyPost/Aftership webhook URL: https://YOUR-DOMAIN/api/tracking/webhook
